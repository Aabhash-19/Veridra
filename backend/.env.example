# App
APP_ENV=development
APP_NAME=Veridra
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
SECRET_KEY=replace_with_random_secret
LOG_LEVEL=INFO
DEBUG_LOG_CONTENT=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Default LLM provider: openai | groq | openrouter | anthropic | gemini
LLM_PROVIDER=gemini

# Option A: OpenAI (ChatGPT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Option B: Groq (fast Llama models, free tier available)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Option C: OpenRouter (access many models with 1 key)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Option D: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Search
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Persistence
DATABASE_URL=sqlite:///./veridra.db
# Production example: postgresql+psycopg://veridra:password@localhost:5432/veridra

# Workflow / guardrails
MAX_EDITOR_REVISIONS=3
MAX_FACT_REMEDIATIONS=2
MAX_RESEARCH_RETRIES=1
MAX_GRAPH_STEPS=24
RUN_TIMEOUT_SECONDS=600
EDITOR_APPROVAL_THRESHOLD=85
MAX_SEARCH_QUERIES=6
MAX_SOURCES=12
MAX_URLS_PER_REQUEST=8
MAX_INPUT_CHARACTERS=12000

# Observability (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=veridra

# Demo mode - must be clearly labeled in the UI
DEMO_MODE=false
